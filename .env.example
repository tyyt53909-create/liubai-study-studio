# Copy via: npm run setup   OR   ./scripts/deploy.sh --domain … --email …
# Never commit a real .env. Do not use these placeholder values on the public internet.

PUBLIC_ORIGIN=http://localhost:4317
# Production must be https://your-domain (deploy.sh sets this from --domain)

# scrypt salt:hash from setup — leave empty in the example file
STUDY_PASSWORD_HASH=

# Local default only. Production compose requires a long random password from setup.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://study:CHANGE_ME@localhost:55439/study

PORT=4317
HOST=127.0.0.1

# Optional Web Push — generated by setup / deploy
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
